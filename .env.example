# Midas login credentials (Turkish phone number without country code, and password)
MIDAS_PHONE=5XXXXXXXXX
MIDAS_PASSWORD=your-password

# Safety: orders with an estimated value above this (in TRY) are rejected
MAX_ORDER_VALUE_TRY=5000

# Run browser headless (true) or visible (false).
HEADLESS=true

# Docker HTTP mode: set both variables; use a random secret of at least 32 characters.
# MCP_HTTP_PORT=3000
# MCP_HTTP_TOKEN=replace-with-long-random-secret
# MIDAS_SESSION_DIR=/data/midas-session
